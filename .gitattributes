# graph.json is regenerated by the post-commit hook in every session, so two
# sessions always conflict on it textually; the union driver in .git/config
# absorbs that. This line predates the eol policy below and must survive it.
graphify-out/graph.json merge=graphify

# The index is uniformly LF; the working tree on Windows was not, because a
# global core.autocrlf=true with no policy here converted on checkout and then
# warned on every touch ("LF will be replaced by CRLF") — 39 files were mixed
# on 2026-09-10. One rule ends both: source stays LF everywhere, and the
# scripted-edit byte scan in CLAUDE.md keeps meaning what it says.
* text=auto
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.db    binary
*.png   binary
*.ico   binary
