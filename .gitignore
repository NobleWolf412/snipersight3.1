# Runtime data — regenerable, machine-specific, large
app/data/
*.db
*.db-shm
*.db-wal
*.log

# Runtime state
app/data/heartbeat.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Node — the linter's install tree only. `app/package-lock.json` IS committed:
# CI runs `npm ci`, which requires it and installs exactly what is pinned there.
node_modules/

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Scratch
scratchpad/
*.tmp

# API credentials — DPAPI ciphertext, never committed
app/data/credentials.vault

# Impeccable: keep the critique record, not machine-local live-mode state
.impeccable/live/

# graphify: commit the graph, the names and the wiki; not the machine-local
# paths, the rebuild cache, or artifacts the post-commit hook rewrites every
# time (they would churn the diff on every single commit).
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cache/
graphify-out/cost.json
graphify-out/graph.html
graphify-out/memory/
graphify-out/reflections/
# Dated rebuild snapshots. Each is a byte-for-byte copy of the graph, report,
# labels and manifest already committed at the top level, plus the cost.json
# ignored two lines up — 6.7 MB per rebuild, and three of them had accumulated
# by 2026-08-09. The current graph is the one anything reads; the old ones are
# what git history is for.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# A DIFFERENT PROJECT, unpacked here for reference on 2026-08-10 — the Spark
# "snipersight-trading" app: its own CLAUDE.md, its own Dockerfiles, a React
# frontend, 1,108 files and 63 MB. It is not a change to this repo and must
# never become one. Ignored rather than deleted because it is not this
# session's to throw away, and ignored rather than left bare because another
# session running `git add -A` would otherwise write all 63 MB into history
# permanently — and the working tree here is genuinely shared.
sst/

# Images pasted into a Codex remote session. Machine-local session scratch —
# they belong to a conversation, not to the repo, and the same `git add -A`
# hazard applies as everything else in this block: a shared working tree makes
# one careless stage permanent.
.codex-remote-attachments/
