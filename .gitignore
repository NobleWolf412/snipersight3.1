# Runtime data — regenerable, machine-specific, large
app/data/
*.db
*.db-shm
*.db-wal
*.log

# Runtime state
app/data/heartbeat.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Node — the linter's install tree only. `app/package-lock.json` IS committed:
# CI runs `npm ci`, which requires it and installs exactly what is pinned there.
node_modules/

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Scratch
scratchpad/
*.tmp

# API credentials — DPAPI ciphertext, never committed
app/data/credentials.vault

# Impeccable: keep the critique record, not machine-local live-mode state
.impeccable/live/

# graphify: commit the graph, the names and the wiki; not the machine-local
# paths, the rebuild cache, or artifacts the post-commit hook rewrites every
# time (they would churn the diff on every single commit).
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cache/
graphify-out/cost.json
graphify-out/graph.html
graphify-out/memory/
graphify-out/reflections/
